<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Performance: only applied when publishing Release (AOT/trimming are
         Release-publish-only; the dev server stays interpreted + untrimmed).
         These cut the WASM payload (measured ~12.9MB interpreted) and speed
         up CPU-bound code by compiling IL -> native WASM. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Use the SAFE default (partial) trim mode. `full` mode strips the
         reflection metadata that Bolero's remoting proxy needs to construct
         the CommunityApi record via FSharpValue.MakeRecord -> runtime crash
         "The record type 'CommunityApi' is invalid". Partial keeps those
         reflection targets while still shrinking the payload. -->
    <TrimMode>partial</TrimMode>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
    <WasmDebugLevel>0</WasmDebugLevel>

    <!-- Elmish MVU trace: independent of WasmDebugLevel (that's the Mono/WASM
         runtime debug setting, unrelated to the Elmish dispatch log). Keep
         this define ON during dev AND when debugging Release/AOT builds so the
         browser console prints every Message dispatch (per AGENTS.md: trace
         first, fix second). Remove the constant to strip the trace for ship. -->
    <DefineConstants>$(DefineConstants);ELMISH_TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="State/RemoteData.fs" />
    <Compile Include="State/Shared.fs" />
    <Compile Include="Ui/RenderProbe.fs" />
    <Compile Include="Ui/RadzenUI.fs" />
    <Compile Include="Pages/Home.fs" />
    <Compile Include="Pages/Games.fs" />
    <Compile Include="Pages/Servers.fs" />
    <Compile Include="Pages/Tournaments.fs" />
    <Compile Include="Pages/Members.fs" />
    <Compile Include="Pages/Teams.fs" />
    <Compile Include="Pages/About.fs" />
    <Compile Include="Pages/Account.fs" />
    <Compile Include="App/App.fs" />
    <Compile Include="Ui/Layout.fs" />
    <Compile Include="Main.fs" />
    <Compile Include="Startup.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Community.Web.Shared\Community.Web.Shared.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Bolero" Version="0.*" />
    <PackageReference Include="Bolero.Build" Version="0.*" />
    <PackageReference Include="Bolero.HotReload" Version="0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.*" />
    <PackageReference Include="Radzen.Blazor" Version="11.2.7" />
  </ItemGroup>
</Project>
