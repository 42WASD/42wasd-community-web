<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Domain/Game.fs" />
    <Compile Include="Domain/Player.fs" />
    <Compile Include="Domain/Team.fs" />
    <Compile Include="Domain/GameServer.fs" />
    <Compile Include="Domain/Tournament.fs" />
    <Compile Include="Domain/News.fs" />
    <Compile Include="Remoting/CommunityApi.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Core Bolero (shared remoting contract), NOT Bolero.Server/Bolero.Client.
         This is the shared library both sides depend on. -->
    <PackageReference Include="Bolero" Version="0.*" />
  </ItemGroup>
</Project>